# .env.example — 복사해서 .env 로 쓰고 실제 키를 채우세요
#   copy .env.example .env
#
# ⚠️ .env 는 절대 커밋하지 마세요 (.gitignore 에 등록되어 있음)

# ─── LLM API (담당 A: 모델 비교) ───────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# UPSTAGE_API_KEY=up_...

# ─── HuggingFace (로컬 모델·임베딩 다운로드) ─────────────
HF_TOKEN=hf_...
